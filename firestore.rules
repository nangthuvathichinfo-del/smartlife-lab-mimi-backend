rules_version = '2';
// Client không bao giờ đọc ghi Firestore trực tiếp: mọi truy cập đi qua mimi-api
// (Admin SDK bỏ qua rules). Rules này là lớp chặn cuối cùng.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
